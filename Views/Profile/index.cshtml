@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Profile";
}

<h2 style="font-family: 'Orbitron', sans-serif; color: #99e6ff; font-weight: bold;">
    Profile
</h2>

<p style="font-family: 'Orbitron', sans-serif; color: #e0e0e0; margin-bottom: 20px;">
    @ViewBag.Message
</p>

@if (Context.Session.GetString("JWToken") != null)
{
    <form asp-controller="Login" asp-action="Logout" method="post"
          style="max-width: 300px; font-family: 'Orbitron', Arial, sans-serif;
                 background: #1a1a1a; padding: 20px; border-radius: 12px;
                 color: #e0e0e0;">

        <button type="submit" class="btn-futuristic-primary">
            Sign Out
        </button>
    </form>
}
