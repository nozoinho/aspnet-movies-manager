<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieCatalog</title>

    <!-- Orbitron Font -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    />

    <!-- Minimal CSS just for global font + background -->
    <style>
        body {
            font-family: 'Orbitron', sans-serif;
            background: #0d0d0d;
        }
    </style>
</head>

<body class="text-light">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-info shadow">
            <div class="container-fluid">

                <!-- Brand with optional icon -->
                <a class="navbar-brand d-flex align-items-center gap-2" 
                   asp-controller="Movies" asp-action="Index">
                    <span class="text-info fw-bold">MovieCatalog</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarCollapse">

                    <ul class="navbar-nav mb-2 mb-lg-0">

                        @* Login/Register switching *@
                        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Register")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Login" asp-action="Index">
                                    Login
                                </a>
                            </li>
                        }

                        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Login")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Register" asp-action="Index">
                                    Register
                                </a>
                            </li>
                        }

                        @* Authenticated links *@
                        @if (Context.Session.GetString("JWToken") != null)
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-info fw-bold text-uppercase" 
                                asp-controller="Movies" asp-action="Index" 
                                role="button" style="font-family: 'Orbitron';">
                                Home
                                </a>
                            </li>
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light fw-bold text-uppercase" 
                                asp-controller="Movies" asp-action="Create" 
                                role="button">
                                Add Movie
                                </a>
                            </li>
                        }
                    </ul>

                    @* User Message + Sign Out *@
                    @if (Context.Session.GetString("JWToken") != null)
                    {
                        <div class="d-flex align-items-center ms-4">
                            <span class="text-info fw-bold me-3">@ViewBag.Message</span>

                            <form asp-controller="Login" asp-action="Logout" method="post">
                                <button type="submit" 
                                        class="btn btn-outline-info fw-bold text-uppercase">
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    }

                </div>
            </div>
        </nav>
    </header>


    <!-- CONTENT -->
    <div class="container my-4">
        <main class="bg-dark bg-opacity-75 p-4 rounded border border-info shadow">
            @RenderBody()
        </main>
    </div>


    <!-- FOOTER -->
    <footer class="bg-dark text-info text-center py-3 border-top border-info mt-auto">
        &copy; 2025 – <strong>MovieCatalog</strong>
    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
