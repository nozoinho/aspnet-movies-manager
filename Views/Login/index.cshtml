@model MovieCatalog.Models.User
@{
    ViewBag.Title = "Login";
}

<div class="container d-flex justify-content-center mt-4">

    <div class="w-100" style="max-width: 420px;">

        <h2 class="text-info fw-bold mb-4 text-center">
            Login
        </h2>

        <form asp-action="Index" method="post"
              class="bg-dark bg-opacity-75 border border-info rounded p-4 shadow">

            <!-- USERNAME -->
            <div class="mb-3">
                <label asp-for="Username" class="form-label text-info fw-semibold">
                    Username
                </label>
                <input asp-for="Username"
                       class="form-control bg-dark text-light border-info"
                       required />
            </div>

            <!-- PASSWORD -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label text-info fw-semibold">
                    Password
                </label>
                <input asp-for="Password" type="password"
                       class="form-control bg-dark text-light border-info"
                       required />
            </div>

            <!-- LOGIN BUTTON -->
            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-outline-info fw-bold text-uppercase">
                    Login
                </button>
            </div>
        </form>

        <!-- ERROR MESSAGE -->
        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <p class="text-danger fw-bold text-center mt-3">
                @ViewBag.Error
            </p>
        }
    </div>
</div>
