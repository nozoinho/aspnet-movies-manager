@model MovieCatalog.Models.Movie

<h2 style="font-family: 'Orbitron', sans-serif; color: #99e6ff; font-weight: bold;">
    Add a Movie
</h2>

<form asp-action="Create" method="post" 
      style="max-width: 400px; font-family: 'Orbitron', Arial, sans-serif; 
             background: #1a1a1a; padding: 20px; border-radius: 12px; 
             color: #e0e0e0;">

    <div style="margin-bottom: 15px;">
        <label asp-for="Title" style="display: block; font-weight: 600; margin-bottom: 6px; color: #66ccff;"></label>
        <input asp-for="Title" 
               style="width: 100%; padding: 10px; border: none; border-radius: 6px; 
                      background: #323d4b; color: #e0e0e0; 
                      box-shadow: inset 0 0 5px rgba(0,0,0,0.6);"/>
        <span asp-validation-for="Title" style="color: #ff4c4c; font-size: 0.9em;"></span>
    </div>

    <div style="margin-bottom: 15px;">
        <label asp-for="Director" style="display: block; font-weight: 600; margin-bottom: 6px; color: #66ccff;"></label>
        <input asp-for="Director" 
               style="width: 100%; padding: 10px; border: none; border-radius: 6px; 
                      background: #323d4b; color: #e0e0e0; 
                      box-shadow: inset 0 0 5px rgba(0,0,0,0.6);"/>
        <span asp-validation-for="Director" style="color: #ff4c4c; font-size: 0.9em;"></span>
    </div>

    <div style="margin-bottom: 15px;">
        <label asp-for="Genre" style="display: block; font-weight: 600; margin-bottom: 6px; color: #66ccff;"></label>
        <input asp-for="Genre" 
               style="width: 100%; padding: 10px; border: none; border-radius: 6px; 
                      background: #323d4b; color: #e0e0e0; 
                      box-shadow: inset 0 0 5px rgba(0,0,0,0.6);"/>
        <span asp-validation-for="Genre" style="color: #ff4c4c; font-size: 0.9em;"></span>
    </div>

    <div style="margin-bottom: 15px;">
        <label asp-for="Year" style="display: block; font-weight: 600; margin-bottom: 6px; color: #66ccff;"></label>
        <input asp-for="Year" 
               style="width: 100%; padding: 10px; border: none; border-radius: 6px; 
                      background: #323d4b; color: #e0e0e0; 
                      box-shadow: inset 0 0 5px rgba(0,0,0,0.6);"/>
    </div>

    <div style="margin-bottom: 15px;">
        <label asp-for="Rating" style="display: block; font-weight: 600; margin-bottom: 6px; color: #66ccff;"></label>
        <input asp-for="Rating" 
               style="width: 100%; padding: 10px; border: none; border-radius: 6px; 
                      background: #323d4b; color: #e0e0e0; 
                      box-shadow: inset 0 0 5px rgba(0,0,0,0.6);"/>
    </div>

    <button type="submit" class="btn-futuristic-primary">
    Save
    </button>
    
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
