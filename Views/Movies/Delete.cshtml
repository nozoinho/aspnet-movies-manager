@model MovieCatalog.Models.Movie

@{
    ViewBag.Title = "Delete Movie";
}

<h2 class="text-center text-danger fw-bold mb-4" style="font-family: 'Orbitron';">
    Delete Movie
</h2>

<p class="text-center text-light mb-4" style="font-family: 'Orbitron';">
    Are you sure you want to delete this movie? This action cannot be undone.
</p>

<div class="mx-auto p-4 bg-dark border border-danger rounded" style="max-width: 600px; font-family: 'Orbitron';">
    <table class="table table-dark table-striped table-hover text-center mb-4">
        <tbody>
            <tr>
                <th class="text-danger">Title</th>
                <td>@Model.Title</td>
            </tr>
            <tr>
                <th class="text-danger">Director</th>
                <td>@Model.Director</td>
            </tr>
            <tr>
                <th class="text-danger">Genre</th>
                <td>@Model.Genre</td>
            </tr>
            <tr>
                <th class="text-danger">Year</th>
                <td>@Model.Year</td>
            </tr>
            <tr>
                <th class="text-danger">Rating</th>
                <td>@Model.Rating</td>
            </tr>
        </tbody>
    </table>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger fw-bold text-uppercase w-100 mb-2">
            Yes, Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary fw-bold text-uppercase w-100">
            Cancel
        </a>
    </form>
</div>
