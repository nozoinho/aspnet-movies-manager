@model MovieCatalog.Models.Movie

<h2 style="font-family: 'Orbitron', sans-serif; color: #1a1a1a; font-weight: bold;">
    Delete Movie
</h2>

<table class="futuristic-table">
    <thead>
        <tr>
            <th colspan="2">Are you sure you want to delete this movie?</th>
        </tr>
    </thead>
    <tbody>
            <tr>
                <td class='fut-neon'>Title</td>
                <td>@Model.Title</td>
            </tr> 
            <tr>
                <td class='fut-neon'>Director</td>   
                <td>@Model.Director</td>
            </tr> 
            <tr> 
                <td class='fut-neon'>Genre</td>
                <td>@Model.Genre</td>
            </tr> 
            <tr> 
                <td class='fut-neon'>Year</td>
                <td>@Model.Year</td>
            </tr> 
            <tr> 
                <td class='fut-neon'>Rating</td>
                <td>@Model.Rating</td>
            </tr>     
    </tbody>
</table>

<style>
    body {
        font-family: 'Orbitron', sans-serif;
        color: #e0e0e0;
    }

    .futuristic-table {
        width: 60%;
        border-collapse: collapse;
        margin: 20px 0;
        background: rgba(20, 20, 20, 0.95);
        border: 1px solid #333;
    }

    .futuristic-table th, 
    .futuristic-table td {
        padding: 12px 15px;
        text-align: center;
        border: 1px solid #333;
    }

    .futuristic-table th {
        background: #1a1a1a;
        color: #66ccff;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: bold;
        font-size: 16px;
    }

    .fut-neon {
        color: #66ccff;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: bold;
        font-size: 16px;
    }


    .futuristic-table tr {
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .futuristic-table tr:nth-child(even) {
        background: rgba(255, 255, 255, 0.05);
    }

    .futuristic-table tr:hover {
        background: rgba(102, 204, 255, 0.15);
        transform: scale(1.02);
    }
</style>

<form asp-action="Delete" method="post" style="font-family: Arial;">
    <input type="hidden" asp-for="Id" />
    <button type="submit" 
            style="padding: 10px 18px; background: linear-gradient(135deg, #dc3545, #ff0019); 
                   color: #fff; border: none; border-radius: 6px; cursor: pointer; 
                   font-size: 1.5em; font-weight: 600; transition: background 0.3s ease;">
        Yes, Delete
    </button>
    <a href="/Movies" style="padding: 10px 18px; font-weight: 600; font-size: 1.5em; color: #66ccff;">
        Cancel
    </a>
</form>