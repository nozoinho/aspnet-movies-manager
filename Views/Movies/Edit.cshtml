@model MovieCatalog.Models.Movie

@{
    ViewBag.Title = "Edit Movie";
}

<h2 class="text-center text-warning fw-bold mb-4" style="font-family: 'Orbitron';">
    Edit Movie
</h2>

<form asp-action="Edit" method="post" class="mx-auto p-4 bg-dark border border-warning rounded" style="max-width: 450px; font-family: 'Orbitron';">
    <div class="mb-3">
        <label asp-for="Title" class="form-label text-warning fw-bold"></label>
        <input asp-for="Title" class="form-control bg-dark text-light border border-warning" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Director" class="form-label text-warning fw-bold"></label>
        <input asp-for="Director" class="form-control bg-dark text-light border border-warning" />
        <span asp-validation-for="Director" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Genre" class="form-label text-warning fw-bold"></label>
        <input asp-for="Genre" class="form-control bg-dark text-light border border-warning" />
        <span asp-validation-for="Genre" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label text-warning fw-bold"></label>
        <input asp-for="Year" class="form-control bg-dark text-light border border-warning" />
    </div>

    <div class="mb-3">
        <label asp-for="Rating" class="form-label text-warning fw-bold"></label>
        <input asp-for="Rating" class="form-control bg-dark text-light border border-warning" />
    </div>

    <button type="submit" class="btn btn-warning fw-bold text-uppercase w-100">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary fw-bold text-uppercase w-100 my-2">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
