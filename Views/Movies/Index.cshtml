@model List<MovieCatalog.Models.Movie>
@using Microsoft.AspNetCore.Http

@{
    ViewBag.Title = "Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-center text-info fw-bold" style="font-family: 'Orbitron'; flex:1;">
        @ViewBag.User's Movie Catalog
    </h2>

    <a asp-controller="Movies" asp-action="Create" class="btn btn-outline-success fw-bold text-uppercase" role="button">
        Add New Movie
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info text-center fw-bold" role="alert" style="font-family: 'Orbitron';">
        No movies found. <br />
        Click <strong>Add New Movie</strong> to start your catalog.
    </div>
}
else
{
    <table class="table table-dark table-striped table-hover text-center align-middle">
        <thead class="table-info text-uppercase">
            <tr>
                <th>Title</th>
                <th>Director</th>
                <th>Genre</th>
                <th>Year</th>
                <th>Rating</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.Director</td>
                    <td>@movie.Genre</td>
                    <td>@movie.Year</td>
                    <td>@movie.Rating</td>
                    <td>
                        <a asp-controller="Movies" asp-action="Edit" asp-route-id="@movie.Id"
                        class="btn btn-sm btn-outline-warning fw-bold text-uppercase">
                        Edit
                        </a>
                    </td>
                    <td>
                        <a asp-controller="Movies" asp-action="Delete" asp-route-id="@movie.Id"
                        class="btn btn-sm btn-outline-danger fw-bold text-uppercase">
                        Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}